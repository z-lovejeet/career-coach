# Copy to .env.local and fill in.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only: limiter, cache, XP, question bank

# Groq (console.groq.com)
GROQ_API_KEY=gsk_...

# Optional: override free-tier limits if your Groq plan is higher
# GROQ_RPM=30
# GROQ_RPD=1000
# GROQ_TPM=8000
# GROQ_TPD=200000

# Optional, operator only: regenerate the public sample roadmaps
# SAMPLES_OWNER_ID=<auth user id that owns sample roadmaps>
# SAMPLES_SECRET=<random string, 16+ chars>
